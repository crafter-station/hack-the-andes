DATABASE_URL=postgresql://user:password@host/database?sslmode=require

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Local/dev Clerk. Production uses HddO78wKpq5PFIEl and
# https://clerk.hacktheandes.com — the published CLI defaults to those values.
CLERK_CLI_OAUTH_CLIENT_ID=1YfuXKgOXkdH094s
CLERK_OAUTH_ISSUER=https://clerk.hacktheandes.com
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Signing secret for a Clerk webhook subscribed to session.created at
# https://your-domain.example/api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me

# Generate with: openssl rand -base64 32
PARTICIPANT_DATA_ENCRYPTION_KEY=replace_with_a_base64_encoded_32_byte_key

# Connect a public Vercel Blob store to the web project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# Optional break-glass administrator IDs. Normal application reviewers should
# receive { "roles": ["application_reviewer"] } in Clerk private metadata.
ADMIN_CLERK_USER_IDS=user_replace_me

RESEND_API_KEY=re_replace_me

# PostHog campaign analytics. Leave the key unset to disable it entirely: the
# app then never loads or initializes PostHog. Set it in the deploy
# environment, not locally, unless you want your own browsing in the reports.
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Trigger.dev project and trigger-only key for the web app.
TRIGGER_SECRET_KEY=tr_dev_sk_replace_me

# HMAC secret used to generate non-secret challenge share codes. Generate with:
# openssl rand -hex 32
CHALLENGE_SEED_SECRET=replace_with_a_hex_secret

# Private challenge engine. Generate the API secret with: openssl rand -hex 32
CHALLENGE_ENGINE_URL=https://your-private-challenge-engine.vercel.app
CHALLENGE_ENGINE_API_SECRET=replace_with_the_engine_api_secret

# Set to true on preview environments to open challenges before their catalog date.
CHALLENGES_FORCE_OPEN=false

